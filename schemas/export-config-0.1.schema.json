{
  "$defs": {
    "AngularUnit": {
      "enum": [
        "deg",
        "rad"
      ],
      "title": "AngularUnit",
      "type": "string"
    },
    "AssignmentType": {
      "enum": [
        "Vol",
        "Surf",
        "Line"
      ],
      "title": "AssignmentType",
      "type": "string"
    },
    "EvidenceProfile": {
      "enum": [
        "minimal",
        "standard",
        "strict"
      ],
      "title": "EvidenceProfile",
      "type": "string"
    },
    "FieldExportConfig": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "items": {
            "type": "string"
          },
          "title": "Assignment",
          "type": "array"
        },
        "coordinate_units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Coordinate Units"
        },
        "excitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excitation"
        },
        "export_field_in_reference": {
          "default": true,
          "title": "Export Field In Reference",
          "type": "boolean"
        },
        "export_in_si_system": {
          "default": true,
          "title": "Export In Si System",
          "type": "boolean"
        },
        "frequency_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Hz"
        },
        "grid": {
          "$ref": "#/$defs/FieldGridConfig"
        },
        "name": {
          "pattern": "^[A-Za-z0-9_]+$",
          "title": "Name",
          "type": "string"
        },
        "object_type": {
          "$ref": "#/$defs/AssignmentType",
          "default": "Vol"
        },
        "phase_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.0,
          "title": "Phase Deg"
        },
        "phase_unit": {
          "$ref": "#/$defs/AngularUnit",
          "default": "deg"
        },
        "phasor_convention": {
          "$ref": "#/$defs/PhasorConvention",
          "default": "unknown"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "reference_coordinate_system": {
          "default": "Global",
          "title": "Reference Coordinate System",
          "type": "string"
        },
        "representation": {
          "anyOf": [
            {
              "$ref": "#/$defs/FieldRepresentation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "value_units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value Units"
        },
        "vector": {
          "default": true,
          "title": "Vector",
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "quantity",
        "grid"
      ],
      "title": "FieldExportConfig",
      "type": "object"
    },
    "FieldGridConfig": {
      "additionalProperties": false,
      "properties": {
        "center": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Center"
        },
        "sample_points_file": {
          "anyOf": [
            {
              "format": "path",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Points File"
        },
        "start": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start"
        },
        "step": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Step"
        },
        "stop": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop"
        },
        "type": {
          "$ref": "#/$defs/GridType",
          "default": "Cartesian"
        }
      },
      "title": "FieldGridConfig",
      "type": "object"
    },
    "FieldRepresentation": {
      "enum": [
        "real_gauge",
        "complex_phasor",
        "phase_evaluated_real",
        "quadrature_reconstructed",
        "magnitude_only"
      ],
      "title": "FieldRepresentation",
      "type": "string"
    },
    "GridType": {
      "enum": [
        "Cartesian",
        "Cylindrical",
        "Spherical"
      ],
      "title": "GridType",
      "type": "string"
    },
    "PhasorConvention": {
      "enum": [
        "exp_positive_iwt_peak",
        "exp_negative_iwt_peak",
        "exp_positive_iwt_rms",
        "exp_negative_iwt_rms",
        "not_applicable",
        "unknown"
      ],
      "title": "PhasorConvention",
      "type": "string"
    },
    "ProjectConfig": {
      "additionalProperties": false,
      "properties": {
        "aedt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Aedt Version"
        },
        "attach_process_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Attach Process Id"
        },
        "design": {
          "title": "Design",
          "type": "string"
        },
        "non_graphical": {
          "default": true,
          "title": "Non Graphical",
          "type": "boolean"
        },
        "path": {
          "format": "path",
          "title": "Path",
          "type": "string"
        },
        "remove_lock": {
          "default": false,
          "title": "Remove Lock",
          "type": "boolean"
        },
        "student_version": {
          "default": false,
          "title": "Student Version",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "design"
      ],
      "title": "ProjectConfig",
      "type": "object"
    },
    "SolutionConfig": {
      "additionalProperties": false,
      "properties": {
        "modes": {
          "items": {
            "type": "integer"
          },
          "title": "Modes",
          "type": "array"
        },
        "setup": {
          "title": "Setup",
          "type": "string"
        },
        "sweep": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sweep"
        },
        "variation": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variation",
          "type": "object"
        }
      },
      "required": [
        "setup"
      ],
      "title": "SolutionConfig",
      "type": "object"
    },
    "TouchstoneConfig": {
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "impedance_ohm": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Impedance Ohm"
        },
        "include_gamma_impedance_comments": {
          "default": true,
          "title": "Include Gamma Impedance Comments",
          "type": "boolean"
        },
        "renormalize": {
          "default": false,
          "title": "Renormalize",
          "type": "boolean"
        }
      },
      "title": "TouchstoneConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "evidence_profile": {
      "$ref": "#/$defs/EvidenceProfile",
      "default": "standard"
    },
    "export_convergence": {
      "default": true,
      "title": "Export Convergence",
      "type": "boolean"
    },
    "export_existing_reports": {
      "default": true,
      "title": "Export Existing Reports",
      "type": "boolean"
    },
    "export_mesh_stats": {
      "default": true,
      "title": "Export Mesh Stats",
      "type": "boolean"
    },
    "export_mesh_visualization": {
      "default": true,
      "title": "Export Mesh Visualization",
      "type": "boolean"
    },
    "export_profile": {
      "default": true,
      "title": "Export Profile",
      "type": "boolean"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldExportConfig"
      },
      "title": "Fields",
      "type": "array"
    },
    "keep_failed": {
      "default": false,
      "title": "Keep Failed",
      "type": "boolean"
    },
    "keep_raw_exports": {
      "default": true,
      "title": "Keep Raw Exports",
      "type": "boolean"
    },
    "max_field_points": {
      "default": 2000000,
      "minimum": 1,
      "title": "Max Field Points",
      "type": "integer"
    },
    "portable_paths": {
      "default": true,
      "title": "Portable Paths",
      "type": "boolean"
    },
    "project": {
      "$ref": "#/$defs/ProjectConfig"
    },
    "report_names": {
      "items": {
        "type": "string"
      },
      "title": "Report Names",
      "type": "array"
    },
    "schema_version": {
      "default": "0.1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "solution": {
      "$ref": "#/$defs/SolutionConfig"
    },
    "strict": {
      "default": true,
      "title": "Strict",
      "type": "boolean"
    },
    "touchstone": {
      "$ref": "#/$defs/TouchstoneConfig"
    }
  },
  "required": [
    "project",
    "solution"
  ],
  "title": "ExportConfig",
  "type": "object"
}
