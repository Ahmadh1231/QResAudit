{
  "$defs": {
    "Diagnostic": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]+$",
          "title": "Code",
          "type": "string"
        },
        "context": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              }
            ]
          },
          "title": "Context",
          "type": "object"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "severity": {
          "$ref": "#/$defs/Severity"
        }
      },
      "required": [
        "code",
        "severity",
        "message"
      ],
      "title": "Diagnostic",
      "type": "object"
    },
    "EigenmodeRecord": {
      "additionalProperties": false,
      "properties": {
        "frequency_unit": {
          "default": "Hz",
          "title": "Frequency Unit",
          "type": "string"
        },
        "mode_count": {
          "minimum": 1,
          "title": "Mode Count",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "q_definition": {
          "default": "hfss_unloaded_material_and_boundary_loss",
          "title": "Q Definition",
          "type": "string"
        }
      },
      "required": [
        "path",
        "mode_count"
      ],
      "title": "EigenmodeRecord",
      "type": "object"
    },
    "EvidenceProfile": {
      "enum": [
        "minimal",
        "standard",
        "strict"
      ],
      "title": "EvidenceProfile",
      "type": "string"
    },
    "ExportStatus": {
      "enum": [
        "building",
        "complete",
        "complete_with_warnings",
        "failed"
      ],
      "title": "ExportStatus",
      "type": "string"
    },
    "FieldRecord": {
      "additionalProperties": false,
      "properties": {
        "assignment": {
          "items": {
            "type": "string"
          },
          "title": "Assignment",
          "type": "array"
        },
        "axis_order": {
          "items": {
            "type": "string"
          },
          "title": "Axis Order",
          "type": "array"
        },
        "complex_data": {
          "title": "Complex Data",
          "type": "boolean"
        },
        "component_labels": {
          "items": {
            "type": "string"
          },
          "title": "Component Labels",
          "type": "array"
        },
        "coordinate_system": {
          "title": "Coordinate System",
          "type": "string"
        },
        "coordinate_units": {
          "title": "Coordinate Units",
          "type": "string"
        },
        "excitation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Excitation"
        },
        "flattening_order": {
          "default": "C",
          "title": "Flattening Order",
          "type": "string"
        },
        "frequency_hz": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency Hz"
        },
        "grid_type": {
          "title": "Grid Type",
          "type": "string"
        },
        "mode": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mode"
        },
        "normalization": {
          "$ref": "#/$defs/NormalizationKind"
        },
        "object_type": {
          "title": "Object Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "phase_deg": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Phase Deg"
        },
        "phasor_convention": {
          "$ref": "#/$defs/PhasorConvention",
          "default": "unknown"
        },
        "point_count": {
          "minimum": 1,
          "title": "Point Count",
          "type": "integer"
        },
        "quantity": {
          "title": "Quantity",
          "type": "string"
        },
        "raw_path": {
          "title": "Raw Path",
          "type": "string"
        },
        "region_name": {
          "title": "Region Name",
          "type": "string"
        },
        "representation": {
          "$ref": "#/$defs/FieldRepresentation",
          "default": "complex_phasor"
        },
        "shape": {
          "items": {
            "type": "integer"
          },
          "title": "Shape",
          "type": "array"
        },
        "solution": {
          "title": "Solution",
          "type": "string"
        },
        "topology": {
          "default": "unstructured",
          "title": "Topology",
          "type": "string"
        },
        "units": {
          "title": "Units",
          "type": "string"
        },
        "variation": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Variation",
          "type": "object"
        },
        "vector": {
          "title": "Vector",
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "raw_path",
        "quantity",
        "complex_data",
        "vector",
        "units",
        "coordinate_units",
        "coordinate_system",
        "grid_type",
        "region_name",
        "assignment",
        "object_type",
        "solution",
        "normalization",
        "shape",
        "point_count"
      ],
      "title": "FieldRecord",
      "type": "object"
    },
    "FieldRepresentation": {
      "enum": [
        "real_gauge",
        "complex_phasor",
        "phase_evaluated_real",
        "quadrature_reconstructed",
        "magnitude_only"
      ],
      "title": "FieldRepresentation",
      "type": "string"
    },
    "FileRecord": {
      "additionalProperties": false,
      "properties": {
        "generated_by": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Generated By"
        },
        "media_type": {
          "title": "Media Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "source_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Path"
        }
      },
      "required": [
        "path",
        "role",
        "media_type",
        "sha256",
        "size_bytes",
        "required"
      ],
      "title": "FileRecord",
      "type": "object"
    },
    "NormalizationKind": {
      "enum": [
        "driven_excitation_dependent",
        "hfss_eigenmode_peak_1",
        "user_scaled",
        "unknown"
      ],
      "title": "NormalizationKind",
      "type": "string"
    },
    "PhasorConvention": {
      "enum": [
        "exp_positive_iwt_peak",
        "exp_negative_iwt_peak",
        "exp_positive_iwt_rms",
        "exp_negative_iwt_rms",
        "not_applicable",
        "unknown"
      ],
      "title": "PhasorConvention",
      "type": "string"
    },
    "Severity": {
      "enum": [
        "info",
        "warning",
        "error"
      ],
      "title": "Severity",
      "type": "string"
    },
    "SolutionKind": {
      "enum": [
        "driven_modal",
        "driven_terminal",
        "eigenmode"
      ],
      "title": "SolutionKind",
      "type": "string"
    },
    "TouchstoneRecord": {
      "additionalProperties": false,
      "properties": {
        "data_format": {
          "title": "Data Format",
          "type": "string"
        },
        "frequency_max_hz": {
          "title": "Frequency Max Hz",
          "type": "number"
        },
        "frequency_min_hz": {
          "title": "Frequency Min Hz",
          "type": "number"
        },
        "frequency_unit": {
          "title": "Frequency Unit",
          "type": "string"
        },
        "number_of_ports": {
          "minimum": 1,
          "title": "Number Of Ports",
          "type": "integer"
        },
        "parameter_type": {
          "default": "S",
          "title": "Parameter Type",
          "type": "string"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "point_count": {
          "minimum": 1,
          "title": "Point Count",
          "type": "integer"
        },
        "port_names": {
          "items": {
            "type": "string"
          },
          "title": "Port Names",
          "type": "array"
        },
        "port_order_verified": {
          "default": false,
          "title": "Port Order Verified",
          "type": "boolean"
        },
        "reference_impedance_imag_ohm": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Reference Impedance Imag Ohm",
          "type": "array"
        },
        "reference_impedance_ohm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Impedance Ohm"
        },
        "reference_impedance_real_ohm": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Reference Impedance Real Ohm",
          "type": "array"
        },
        "renormalization_impedance_ohm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Renormalization Impedance Ohm"
        },
        "renormalized": {
          "title": "Renormalized",
          "type": "boolean"
        },
        "source_excitation_names": {
          "items": {
            "type": "string"
          },
          "title": "Source Excitation Names",
          "type": "array"
        },
        "source_impedance_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Impedance Path"
        },
        "source_impedance_preserved": {
          "default": true,
          "title": "Source Impedance Preserved",
          "type": "boolean"
        },
        "source_reference_impedance_imag_ohm": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Source Reference Impedance Imag Ohm",
          "type": "array"
        },
        "source_reference_impedance_real_ohm": {
          "items": {
            "items": {
              "type": "number"
            },
            "type": "array"
          },
          "title": "Source Reference Impedance Real Ohm",
          "type": "array"
        },
        "touchstone_version": {
          "default": "1.0",
          "title": "Touchstone Version",
          "type": "string"
        },
        "wave_definition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wave Definition"
        }
      },
      "required": [
        "path",
        "number_of_ports",
        "frequency_unit",
        "data_format",
        "renormalized",
        "port_names",
        "frequency_min_hz",
        "frequency_max_hz",
        "point_count"
      ],
      "title": "TouchstoneRecord",
      "type": "object"
    },
    "VariationValue": {
      "additionalProperties": false,
      "properties": {
        "declared_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Declared Unit"
        },
        "evaluated_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Unit"
        },
        "evaluated_value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Value"
        },
        "evaluated_value_basis": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Value Basis"
        },
        "expression": {
          "title": "Expression",
          "type": "string"
        }
      },
      "required": [
        "expression"
      ],
      "title": "VariationValue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "aedt_version": {
      "title": "Aedt Version",
      "type": "string"
    },
    "bundle_status": {
      "$ref": "#/$defs/ExportStatus"
    },
    "design_name": {
      "title": "Design Name",
      "type": "string"
    },
    "design_type": {
      "title": "Design Type",
      "type": "string"
    },
    "design_variables": {
      "additionalProperties": {
        "$ref": "#/$defs/VariationValue"
      },
      "title": "Design Variables",
      "type": "object"
    },
    "diagnostics": {
      "items": {
        "$ref": "#/$defs/Diagnostic"
      },
      "title": "Diagnostics",
      "type": "array"
    },
    "eigenmode": {
      "anyOf": [
        {
          "$ref": "#/$defs/EigenmodeRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_profile": {
      "$ref": "#/$defs/EvidenceProfile",
      "default": "standard"
    },
    "export_timestamp_utc": {
      "format": "date-time",
      "title": "Export Timestamp Utc",
      "type": "string"
    },
    "exporter_version": {
      "title": "Exporter Version",
      "type": "string"
    },
    "fields": {
      "items": {
        "$ref": "#/$defs/FieldRecord"
      },
      "title": "Fields",
      "type": "array"
    },
    "files": {
      "items": {
        "$ref": "#/$defs/FileRecord"
      },
      "title": "Files",
      "type": "array"
    },
    "model_units": {
      "title": "Model Units",
      "type": "string"
    },
    "operating_system": {
      "title": "Operating System",
      "type": "string"
    },
    "ports": {
      "items": {
        "type": "string"
      },
      "title": "Ports",
      "type": "array"
    },
    "project_file_name": {
      "title": "Project File Name",
      "type": "string"
    },
    "project_file_sha256": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Project File Sha256"
    },
    "project_name": {
      "title": "Project Name",
      "type": "string"
    },
    "project_variables": {
      "additionalProperties": {
        "$ref": "#/$defs/VariationValue"
      },
      "title": "Project Variables",
      "type": "object"
    },
    "pyaedt_version": {
      "title": "Pyaedt Version",
      "type": "string"
    },
    "python_version": {
      "title": "Python Version",
      "type": "string"
    },
    "reference_coordinate_system": {
      "title": "Reference Coordinate System",
      "type": "string"
    },
    "run_id": {
      "pattern": "^(?:[0-9a-f]{8}|[0-9a-f]{32})$",
      "title": "Run Id",
      "type": "string"
    },
    "schema_version": {
      "default": "0.1.1",
      "title": "Schema Version",
      "type": "string"
    },
    "setup_name": {
      "title": "Setup Name",
      "type": "string"
    },
    "solution_kind": {
      "$ref": "#/$defs/SolutionKind"
    },
    "solution_reference": {
      "title": "Solution Reference",
      "type": "string"
    },
    "solved_variation": {
      "additionalProperties": {
        "$ref": "#/$defs/VariationValue"
      },
      "title": "Solved Variation",
      "type": "object"
    },
    "sweep_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Sweep Name"
    },
    "touchstone": {
      "anyOf": [
        {
          "$ref": "#/$defs/TouchstoneRecord"
        },
        {
          "type": "null"
        }
      ]
    },
    "variation": {
      "additionalProperties": {
        "$ref": "#/$defs/VariationValue"
      },
      "title": "Variation",
      "type": "object"
    },
    "variation_id": {
      "title": "Variation Id",
      "type": "string"
    }
  },
  "required": [
    "exporter_version",
    "bundle_status",
    "run_id",
    "export_timestamp_utc",
    "project_name",
    "project_file_name",
    "project_file_sha256",
    "design_name",
    "design_type",
    "solution_kind",
    "setup_name",
    "sweep_name",
    "solution_reference",
    "variation_id",
    "variation",
    "aedt_version",
    "pyaedt_version",
    "python_version",
    "operating_system",
    "model_units",
    "reference_coordinate_system",
    "ports",
    "touchstone",
    "eigenmode",
    "fields",
    "files",
    "diagnostics"
  ],
  "title": "HFSSRunManifest",
  "type": "object"
}
